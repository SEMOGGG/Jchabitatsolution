# ------------------------------------------------------------
# Copier ce fichier en .env.local (en local) et renseigner les
# mêmes variables dans Vercel > Project > Settings > Environment Variables
# ------------------------------------------------------------

# Clerk (https://dashboard.clerk.com > API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/connexion
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/admin

# E-mails qui ont toujours le rôle admin, séparés par des virgules
# (permet au premier compte d'accéder au back-office)
ADMIN_EMAILS=jc.habitatsolution@gmail.com

# Supabase (https://supabase.com > Project Settings > API)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJxxx

# Resend (https://resend.com > API Keys)
RESEND_API_KEY=re_xxx
# Tant que le domaine n'est pas vérifié dans Resend, utiliser onboarding@resend.dev
EMAIL_FROM="JC Habitat Solutions <onboarding@resend.dev>"
# Adresse qui reçoit les nouvelles demandes (peut aussi être réglée dans le back-office)
ADMIN_NOTIFICATION_EMAIL=jc.habitatsolution@gmail.com

# URL publique du site (sans slash final), utilisée dans les e-mails
NEXT_PUBLIC_SITE_URL=http://localhost:3000
